# Supabase PostgreSQL Connection String (Pooler - Transaction mode for Prisma)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection String (Session mode - for Prisma migrations)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Next.js Authentication Secret
JWT_SECRET="nexarank-super-secure-production-jwt-secret-key-32chars"

# Public App URL (Your Vercel URL, e.g., https://your-site.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
