APP_NAME="NexaRank CMS"
APP_ENV=production
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE
APP_DEBUG=false
APP_TIMEZONE="Asia/Karachi"
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE CONFIGURATION ---
# Option 1: Supabase / PostgreSQL (Recommended for production)
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your_supabase_project_id
DB_PASSWORD="your_supabase_db_password"

# Option 2: Local SQLite (for local testing)
# DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/database.sqlite

# Option 3: Local MySQL / XAMPP / WAMP
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nexarank_cms
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000

FILESYSTEM_DISK=public

CACHE_STORE=database
QUEUE_CONNECTION=sync
